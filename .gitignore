# ====================================================
# Sudoku Game Monorepo .gitignore
# Python (app/) + Terraform (terraform/)
# ====================================================

# ----------------------------------------------------
# 1. Python cache files (inside app/)
# ----------------------------------------------------

app/__pycache__/
app/*.pyc
app/*.pyo
app/*.pyd

# Or use recursive pattern to catch any __pycache__ anywhere
# **/__pycache__/

# ----------------------------------------------------
# 2. Python virtual environment (if created inside app/)
# ----------------------------------------------------
app/venv/
app/env/
app/.venv/

# ----------------------------------------------------
# 3. IDE files (project-wide)
# ----------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
app/.idea/

# ----------------------------------------------------
# 4. Environment files (project-wide)
# ----------------------------------------------------
.env
.env.local
*.secret

# ----------------------------------------------------
# 5. Logs (project-wide)
# ----------------------------------------------------
*.log
logs/
tmp/

# ----------------------------------------------------
# 6. Terraform files
# ----------------------------------------------------
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.lock.info
terraform/*.tfstate.backup
terraform/*.tfstate.backup.*
terraform/.terraform.lock.hcl
terraform/.terraform.tfstate.lock.info
terraform/terraform.tfvars
terraform/terraform.tfvars.json


# ----------------------------------------------------
# 7. Docker-related (project-wide)
# ----------------------------------------------------
*.tar
*.tar.gz
*.tgz

# ----------------------------------------------------
# 8. OS-specific files
# ----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------------------------------
# 9. Test coverage (inside app/)
# ----------------------------------------------------
app/.coverage
app/htmlcov/
app/.pytest_cache/

# ----------------------------------------------------
# 10. Packaging (inside app/)
# ----------------------------------------------------
app/dist/
app/build/
app/*.egg-info/

# ----------------------------------------------------
# 11. Application-specific
# ----------------------------------------------------
# app/app_secrets.py
# app/config.local.py

build/
dist/
*.egg-info/

# K8s / Debug
*.log
deployment-info.txt
k8s-state.txt
public-ips.txt
# Local SQLite database
app/instance/
*.db
*.sqlite
*.sqlite3
